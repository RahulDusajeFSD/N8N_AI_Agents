        "jsCode": "const data = $input.all().map((item)=> item);\n\nconst groupedData ={};\n\nfor(var i=0;i<data.length;i++){\n   \n   const emailOfResource = data[i].json.email;\n   const resourceOfResource = data[i].json.Resource;\n   const hoursOfResource = data[i].json.September29_Hours;\n   \n   if(!groupedData[emailOfResource]){ // checking if object does not exist in groupedData already, if not then adding the object\n   \n   \n   \n       groupedData[emailOfResource] = {\n       'email': emailOfResource,\n       'resource':resourceOfResource,\n       'hours':hoursOfResource\n   \n \n   }\n   \n   \n       \n   }\n   else{\n       groupedData[emailOfResource].hours+=hoursOfResource\n       \n   }\n   \n   \n   \n   \n}\n\n// Object.entries() -> object to array conversion\n// Object.fromEntries() -> array to object\n// Object.keys() -> fetch key of an object\n\n// const emails = Object.keys(Object.fromEntries(Object.entries(groupedData).filter(([key, value])=> \n\n// value.hours <40\n\n// )));\n\n\nreturn {attendees: (Object.values( Object.fromEntries( Object.entries(groupedData).filter(([key, value])=> value.hours <40 )) ) ).map((item)=> ({email: item.email})) };"
